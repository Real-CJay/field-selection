-- EMERGENCY LOCKDOWN
-- Run in the SQL Editor of the LIVE field-selection Supabase project.
-- This stops all anon/authenticated browser access to every public table,
-- sequence, and function. The current direct-from-browser student portal will
-- no longer read or save data until it is redesigned to use authenticated,
-- restrictive policies or backend API routes.
--
-- The backend must use a real service_role/secret key; do not place that key
-- in frontend environment variables.

begin;

-- Enable RLS everywhere in the exposed public schema, including any table
-- that was added outside this repository.
do $$
declare
  table_record record;
begin
  for table_record in
    select tablename
    from pg_tables
    where schemaname = 'public'
  loop
    execute format(
      'alter table public.%I enable row level security',
      table_record.tablename
    );
    execute format(
      'revoke all privileges on table public.%I from anon, authenticated',
      table_record.tablename
    );
  end loop;
end;
$$;

-- Remove any existing policies. This is intentional for incident containment:
-- without policies, RLS denies anon/authenticated rows by default.
do $$
declare
  policy_record record;
begin
  for policy_record in
    select tablename, policyname
    from pg_policies
    where schemaname = 'public'
  loop
    execute format(
      'drop policy if exists %I on public.%I',
      policy_record.policyname,
      policy_record.tablename
    );
  end loop;
end;
$$;

revoke all privileges on all sequences in schema public from anon, authenticated;
revoke all privileges on all functions in schema public from anon, authenticated;

commit;

-- Verification: every public table should now show row_security_enabled = true
-- and policy_count = 0.
select
  tables.tablename,
  tables.rowsecurity as row_security_enabled,
  coalesce(policies.policy_count, 0) as policy_count
from pg_tables as tables
left join (
  select tablename, count(*) as policy_count
  from pg_policies
  where schemaname = 'public'
  group by tablename
) as policies on policies.tablename = tables.tablename
where tables.schemaname = 'public'
order by tables.tablename;
