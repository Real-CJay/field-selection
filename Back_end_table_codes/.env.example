SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-secret-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
AUTH_RATE_LIMIT_HMAC_KEY=use-a-long-random-secret-value
MAINTENANCE_MODE=true
MAINTENANCE_PREVIEW_INDEXES=250314P,250544U
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=use-a-long-random-password
ALLOCATION_STATE_LIMIT=10000
