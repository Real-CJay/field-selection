create table if not exists public.grade_correction_requests (
  id bigint generated by default as identity primary key,
  index_number text not null references public.students(index_number) on delete cascade,
  module text not null check (module in ('cse', 'maths', 'electrical', 'material')),
  current_grade text not null check (current_grade in ('A / A+', 'A-', 'B+', 'B', 'B-', 'C+', 'C', 'C-', 'D', 'F', 'Not available')),
  requested_grade text not null check (requested_grade in ('A+', 'A', 'A-', 'B+', 'B', 'B-', 'C+', 'C', 'C-', 'D', 'F')),
  status text not null default 'pending' check (status in ('pending', 'approved', 'rejected', 'superseded', 'reverted')),
  created_at timestamptz not null default now(),
  reviewed_at timestamptz,
  reverted_at timestamptz
);

create unique index if not exists one_pending_grade_request_per_module
  on public.grade_correction_requests (index_number, module)
  where status = 'pending';

alter table public.grade_correction_requests enable row level security;
revoke all on table public.grade_correction_requests from anon, authenticated;
revoke all on sequence public.grade_correction_requests_id_seq from anon, authenticated;
grant select, insert, update on table public.grade_correction_requests to service_role;
grant usage, select on sequence public.grade_correction_requests_id_seq to service_role;
