-- Secure student authentication and browser access policies.
-- Review and run in the Supabase SQL Editor after taking a database backup.
-- Run create_student_preferences_history.psql first so preference changes are audited.

begin;

create schema if not exists private;

-- One registered email must identify at most one student before Auth users can be linked.
do $$
begin
  if exists (
    select 1
    from public.students
    where email is not null and btrim(email) <> ''
    group by lower(btrim(email))
    having count(*) > 1
  ) then
    raise exception 'Duplicate registered student emails must be resolved before enabling Auth ownership.';
  end if;
end;
$$;

alter table public.students
  add column if not exists auth_user_id uuid references auth.users(id) on delete set null;

create unique index if not exists students_auth_user_id_unique
  on public.students (auth_user_id)
  where auth_user_id is not null;

create unique index if not exists students_registered_email_unique
  on public.students (lower(btrim(email)))
  where email is not null and btrim(email) <> '';

create table if not exists public.student_auth_requests (
  id bigint generated always as identity primary key,
  index_hash text not null,
  ip_hash text not null,
  request_type text not null check (request_type in ('magic_link', 'password')),
  outcome text not null check (outcome in ('sent', 'failed', 'success')),
  created_at timestamptz not null default now()
);

create index if not exists student_auth_requests_index_time
  on public.student_auth_requests (index_hash, request_type, outcome, created_at desc);
create index if not exists student_auth_requests_ip_time
  on public.student_auth_requests (ip_hash, request_type, outcome, created_at desc);
create index if not exists student_auth_requests_type_time
  on public.student_auth_requests (request_type, outcome, created_at desc);

-- Check limits and reserve an audit row in one transaction. The advisory lock
-- prevents concurrent requests from stepping past the daily ceiling.
create or replace function public.reserve_student_auth_request(
  p_index_hash text,
  p_ip_hash text,
  p_request_type text
)
returns bigint
language plpgsql
security definer
set search_path = pg_catalog, public
as $$
declare
  request_id bigint;
  current_time timestamptz := now();
begin
  if p_request_type not in ('magic_link', 'password') then
    raise exception 'Invalid authentication request type.';
  end if;

  perform pg_advisory_xact_lock(72150420260802);

  delete from public.student_auth_requests
  where created_at < current_time - interval '7 days';

  if p_request_type = 'magic_link' then
    if (select count(*) from public.student_auth_requests
        where request_type = 'magic_link'
          and index_hash = p_index_hash
          and created_at >= current_time - interval '60 seconds') >= 1
      or (select count(*) from public.student_auth_requests
          where request_type = 'magic_link'
            and index_hash = p_index_hash
            and created_at >= current_time - interval '1 day') >= 3
      or (select count(*) from public.student_auth_requests
          where request_type = 'magic_link'
            and ip_hash = p_ip_hash
            and created_at >= current_time - interval '1 hour') >= 20
      or (select count(*) from public.student_auth_requests
          where request_type = 'magic_link'
            and ip_hash = p_ip_hash
            and created_at >= current_time - interval '1 day') >= 100
      or (select count(*) from public.student_auth_requests
          where request_type = 'magic_link'
            and created_at >= current_time - interval '1 day') >= 280 then
      raise exception 'AUTH_RATE_LIMIT' using errcode = 'P0001';
    end if;
  elsif (select count(*) from public.student_auth_requests
         where request_type = 'password'
           and index_hash = p_index_hash
           and ip_hash = p_ip_hash
           and outcome = 'failed'
           and created_at >= current_time - interval '15 minutes') >= 5 then
    raise exception 'AUTH_RATE_LIMIT' using errcode = 'P0001';
  end if;

  -- Failed is the safe reservation state. The backend changes it to sent or
  -- success only after the external authentication call succeeds.
  insert into public.student_auth_requests (
    index_hash, ip_hash, request_type, outcome
  ) values (
    p_index_hash, p_ip_hash, p_request_type, 'failed'
  ) returning id into request_id;

  return request_id;
end;
$$;

revoke all on function public.reserve_student_auth_request(text, text, text)
  from public, anon, authenticated;
grant execute on function public.reserve_student_auth_request(text, text, text)
  to service_role;

alter table public.students enable row level security;
alter table public.student_results enable row level security;
alter table public.student_preferences enable row level security;
alter table public.student_auth_requests enable row level security;

-- Start from no browser writes anywhere, then grant only the two owned tables below.
do $$
declare
  table_record record;
begin
  for table_record in
    select tablename from pg_tables where schemaname = 'public'
  loop
    execute format(
      'revoke insert, update, delete, truncate, references, trigger on table public.%I from anon, authenticated',
      table_record.tablename
    );
  end loop;
end;
$$;

-- Browser roles never need direct sequence access. Inserts that use identity
-- values are performed by the backend service role or by security-definer triggers.
do $$
declare
  sequence_record record;
begin
  for sequence_record in
    select sequencename from pg_sequences where schemaname = 'public'
  loop
    execute format(
      'revoke all on sequence public.%I from anon, authenticated',
      sequence_record.sequencename
    );
  end loop;
end;
$$;

revoke all on table public.students from anon, authenticated;
grant select (index_number, name) on table public.students to anon, authenticated;

revoke all on table public.student_results from anon, authenticated;
grant select on table public.student_results to anon;
grant select on table public.student_results to authenticated;
grant insert (index_number, fluids, mechanics) on table public.student_results to authenticated;
grant update (fluids, mechanics) on table public.student_results to authenticated;

revoke all on table public.student_preferences from anon, authenticated;
grant select on table public.student_preferences to anon;
grant select on table public.student_preferences to authenticated;
grant insert (
  index_number, biomedical, chemical, civil, computer, electrical,
  electronic, mechanical, material, aeronautical, mechatronics, submitted_at
) on table public.student_preferences to authenticated;
grant update (
  biomedical, chemical, civil, computer, electrical,
  electronic, mechanical, material, aeronautical, mechatronics, submitted_at
) on table public.student_preferences to authenticated;

revoke all on table public.student_auth_requests from anon, authenticated;
revoke all on sequence public.student_auth_requests_id_seq from anon, authenticated;
grant all on table public.student_auth_requests to service_role;
grant usage, select on sequence public.student_auth_requests_id_seq to service_role;

-- Ownership lookup stays in a non-exposed schema and explicitly requires auth.uid().
create or replace function private.owns_student_index(candidate_index varchar)
returns boolean
language sql
stable
security definer
set search_path = pg_catalog, public, private
as $$
  select (select auth.uid()) is not null
    and exists (
      select 1
      from public.students
      where students.index_number = candidate_index
        and students.auth_user_id = (select auth.uid())
    );
$$;

revoke all on function private.owns_student_index(varchar) from public, anon;
grant usage on schema private to authenticated;
grant execute on function private.owns_student_index(varchar) to authenticated;

-- Remove every pre-existing policy on these tables. PostgreSQL ORs permissive
-- policies, so retaining an older policy could defeat the restrictions below.
do $$
declare
  policy_record record;
begin
  for policy_record in
    select schemaname, tablename, policyname
    from pg_policies
    where schemaname = 'public'
      and tablename in (
        'students', 'student_results', 'student_preferences', 'student_auth_requests'
      )
  loop
    execute format(
      'drop policy if exists %I on %I.%I',
      policy_record.policyname,
      policy_record.schemaname,
      policy_record.tablename
    );
  end loop;
end;
$$;

drop policy if exists students_read_registry_identity on public.students;
create policy students_read_registry_identity
  on public.students for select to anon
  using (true);

drop policy if exists students_read_own_identity on public.students;
create policy students_read_own_identity
  on public.students for select to authenticated
  using (auth_user_id = (select auth.uid()));

drop policy if exists results_read_only_public on public.student_results;
create policy results_read_only_public
  on public.student_results for select to anon
  using (true);

drop policy if exists results_read_own on public.student_results;
create policy results_read_own
  on public.student_results for select to authenticated
  using ((select private.owns_student_index(index_number)));

drop policy if exists results_insert_own on public.student_results;
create policy results_insert_own
  on public.student_results for insert to authenticated
  with check ((select private.owns_student_index(index_number)));

drop policy if exists results_update_own on public.student_results;
create policy results_update_own
  on public.student_results for update to authenticated
  using ((select private.owns_student_index(index_number)))
  with check ((select private.owns_student_index(index_number)));

drop policy if exists preferences_read_only_public on public.student_preferences;
create policy preferences_read_only_public
  on public.student_preferences for select to anon
  using (true);

drop policy if exists preferences_read_own on public.student_preferences;
create policy preferences_read_own
  on public.student_preferences for select to authenticated
  using ((select private.owns_student_index(index_number)));

drop policy if exists preferences_insert_own on public.student_preferences;
create policy preferences_insert_own
  on public.student_preferences for insert to authenticated
  with check ((select private.owns_student_index(index_number)));

drop policy if exists preferences_update_own on public.student_preferences;
create policy preferences_update_own
  on public.student_preferences for update to authenticated
  using ((select private.owns_student_index(index_number)))
  with check ((select private.owns_student_index(index_number)));

commit;

-- Verification: browser roles should have only the grants intentionally listed above.
select grantee, table_name, privilege_type
from information_schema.role_table_grants
where table_schema = 'public'
  and grantee in ('anon', 'authenticated')
order by table_name, grantee, privilege_type;

select schemaname, tablename, policyname, roles, cmd
from pg_policies
where schemaname = 'public'
order by tablename, policyname;
