-- Full least-privilege browser access and student ownership migration.
-- Run security_incident_lockdown.psql first, then deploy the matching backend
-- and frontend before running this migration.

begin;

create schema if not exists private;
revoke all on schema private from public, anon, authenticated;

do $$
begin
  if exists (
    select 1 from public.students group by index_number having count(*) > 1
  ) then
    raise exception 'Duplicate student index numbers must be resolved before enabling Auth ownership.';
  end if;
  if exists (
    select 1 from public.student_results group by index_number having count(*) > 1
  ) then
    raise exception 'Duplicate student-result index numbers must be resolved before enabling Auth ownership.';
  end if;
  if exists (
    select 1 from public.student_preferences group by index_number having count(*) > 1
  ) then
    raise exception 'Duplicate student-preference index numbers must be resolved before enabling Auth ownership.';
  end if;
  if exists (
    select 1
    from public.students
    where email is not null and btrim(email) <> ''
    group by lower(btrim(email))
    having count(*) > 1
  ) then
    raise exception 'Duplicate registered student emails must be resolved before enabling Auth ownership.';
  end if;
end;
$$;

alter table public.students
  add column if not exists auth_user_id uuid references auth.users(id) on delete set null;

create unique index if not exists students_auth_user_id_unique
  on public.students (auth_user_id)
  where auth_user_id is not null;
create unique index if not exists students_registered_email_unique
  on public.students (lower(btrim(email)))
  where email is not null and btrim(email) <> '';

create table if not exists private.field_selection_security_settings (
  singleton boolean primary key default true check (singleton),
  maintenance_mode boolean not null default true,
  preview_indexes text[] not null default array['250314P', '250544U']::text[],
  updated_at timestamptz not null default now()
);

insert into private.field_selection_security_settings (
  singleton, maintenance_mode, preview_indexes
) values (
  true, true, array['250314P', '250544U']::text[]
) on conflict (singleton) do update
set maintenance_mode = true,
    preview_indexes = excluded.preview_indexes,
    updated_at = now();

create table if not exists public.student_auth_requests (
  id bigint generated always as identity primary key,
  index_hash text not null,
  ip_hash text not null,
  request_type text not null,
  outcome text not null check (outcome in ('sent', 'failed', 'success')),
  created_at timestamptz not null default now()
);

alter table public.student_auth_requests
  drop constraint if exists student_auth_requests_request_type_check;
alter table public.student_auth_requests
  add constraint student_auth_requests_request_type_check
  check (request_type in ('magic_link', 'login', 'password', 'admin_login'));

create index if not exists student_auth_requests_index_time
  on public.student_auth_requests (index_hash, request_type, outcome, created_at desc);
create index if not exists student_auth_requests_ip_time
  on public.student_auth_requests (ip_hash, request_type, outcome, created_at desc);
create index if not exists student_auth_requests_type_time
  on public.student_auth_requests (request_type, outcome, created_at desc);

create table if not exists public.admin_action_audit (
  id bigint generated always as identity primary key,
  admin_username text not null,
  action text not null,
  target text not null,
  details jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now()
);
create index if not exists admin_action_audit_created_at
  on public.admin_action_audit (created_at desc);

create or replace function public.reserve_student_auth_request(
  p_index_hash text,
  p_ip_hash text,
  p_request_type text
)
returns bigint
language plpgsql
security invoker
set search_path = pg_catalog, public
as $$
declare
  request_id bigint;
  current_time timestamptz := now();
begin
  if p_request_type not in ('magic_link', 'login', 'password', 'admin_login') then
    raise exception 'Invalid authentication request type.';
  end if;

  perform pg_advisory_xact_lock(72150420260802);

  delete from public.student_auth_requests
  where created_at < current_time - interval '7 days';

  if p_request_type = 'magic_link' then
    if (select count(*) from public.student_auth_requests
        where request_type = 'magic_link'
          and index_hash = p_index_hash
          and created_at >= current_time - interval '60 seconds') >= 1
      or (select count(*) from public.student_auth_requests
          where request_type = 'magic_link'
            and index_hash = p_index_hash
            and created_at >= current_time - interval '1 day') >= 3
      or (select count(*) from public.student_auth_requests
          where request_type = 'magic_link'
            and ip_hash = p_ip_hash
            and created_at >= current_time - interval '1 hour') >= 20
      or (select count(*) from public.student_auth_requests
          where request_type = 'magic_link'
            and ip_hash = p_ip_hash
            and created_at >= current_time - interval '1 day') >= 100
      or (select count(*) from public.student_auth_requests
          where request_type = 'magic_link'
            and created_at >= current_time - interval '1 day') >= 280 then
      raise exception 'AUTH_RATE_LIMIT' using errcode = 'P0001';
    end if;
  elsif (select count(*) from public.student_auth_requests
         where request_type = p_request_type
           and index_hash = p_index_hash
           and ip_hash = p_ip_hash
           and outcome = 'failed'
           and created_at >= current_time - interval '15 minutes') >= 5
    or (select count(*) from public.student_auth_requests
        where request_type = p_request_type
          and ip_hash = p_ip_hash
          and created_at >= current_time - interval '1 hour') >= 20 then
    raise exception 'AUTH_RATE_LIMIT' using errcode = 'P0001';
  end if;

  insert into public.student_auth_requests (
    index_hash, ip_hash, request_type, outcome
  ) values (
    p_index_hash, p_ip_hash, p_request_type, 'failed'
  ) returning id into request_id;

  return request_id;
end;
$$;

revoke all on function public.reserve_student_auth_request(text, text, text)
  from public, anon, authenticated;
grant execute on function public.reserve_student_auth_request(text, text, text)
  to service_role;

create or replace function private.owns_enabled_student_index(candidate_index varchar)
returns boolean
language sql
stable
security definer
set search_path = ''
as $$
  select (select auth.uid()) is not null
    and exists (
      select 1
      from public.students
      where students.index_number = candidate_index
        and students.auth_user_id = (select auth.uid())
    )
    and exists (
      select 1
      from private.field_selection_security_settings settings
      where settings.singleton
        and (
          not settings.maintenance_mode
          or candidate_index = any(settings.preview_indexes)
        )
    );
$$;

revoke all on function private.owns_enabled_student_index(varchar)
  from public, anon, authenticated, service_role;
grant usage on schema private to authenticated;
grant execute on function private.owns_enabled_student_index(varchar)
  to authenticated;

do $$
declare
  table_record record;
begin
  for table_record in
    select tablename from pg_tables where schemaname = 'public'
  loop
    execute format('alter table public.%I enable row level security', table_record.tablename);
    execute format(
      'revoke all privileges on table public.%I from public, anon, authenticated',
      table_record.tablename
    );
  end loop;
end;
$$;

do $$
declare
  sequence_record record;
begin
  for sequence_record in
    select sequencename from pg_sequences where schemaname = 'public'
  loop
    execute format(
      'revoke all privileges on sequence public.%I from public, anon, authenticated',
      sequence_record.sequencename
    );
  end loop;
end;
$$;

do $$
declare
  function_record record;
begin
  for function_record in
    select p.oid::regprocedure as signature
    from pg_proc p
    join pg_namespace n on n.oid = p.pronamespace
    where n.nspname = 'public'
  loop
    execute format(
      'revoke all privileges on function %s from public, anon, authenticated',
      function_record.signature
    );
  end loop;
end;
$$;

revoke create on schema public from public, anon, authenticated;
alter default privileges for role postgres in schema public
  revoke all privileges on tables from public, anon, authenticated;
alter default privileges for role postgres in schema public
  revoke all privileges on sequences from public, anon, authenticated;
alter default privileges for role postgres in schema public
  revoke all privileges on functions from public, anon, authenticated;

do $$
declare
  policy_record record;
begin
  for policy_record in
    select schemaname, tablename, policyname
    from pg_policies
    where schemaname = 'public'
      and tablename in (
        'students', 'student_results', 'student_preferences',
        'student_auth_requests', 'admin_action_audit'
      )
  loop
    execute format(
      'drop policy if exists %I on %I.%I',
      policy_record.policyname,
      policy_record.schemaname,
      policy_record.tablename
    );
  end loop;
end;
$$;

do $$
begin
  if to_regprocedure('private.owns_student_index(character varying)') is not null then
    execute 'revoke all on function private.owns_student_index(varchar) '
      || 'from public, anon, authenticated';
  end if;
end;
$$;

grant select (index_number, name) on table public.students to authenticated;
create policy students_read_own_identity
  on public.students for select to authenticated
  using ((select private.owns_enabled_student_index(index_number)));

grant select on table public.student_results to authenticated;
grant insert (index_number, fluids, mechanics) on table public.student_results to authenticated;
grant update (fluids, mechanics) on table public.student_results to authenticated;
create policy results_read_own
  on public.student_results for select to authenticated
  using ((select private.owns_enabled_student_index(index_number)));
create policy results_insert_own
  on public.student_results for insert to authenticated
  with check ((select private.owns_enabled_student_index(index_number)));
create policy results_update_own
  on public.student_results for update to authenticated
  using ((select private.owns_enabled_student_index(index_number)))
  with check ((select private.owns_enabled_student_index(index_number)));

grant select on table public.student_preferences to authenticated;
grant insert (
  index_number, biomedical, chemical, civil, computer, electrical,
  electronic, mechanical, material, aeronautical, mechatronics
) on table public.student_preferences to authenticated;
grant update (
  biomedical, chemical, civil, computer, electrical,
  electronic, mechanical, material, aeronautical, mechatronics
) on table public.student_preferences to authenticated;
create policy preferences_read_own
  on public.student_preferences for select to authenticated
  using ((select private.owns_enabled_student_index(index_number)));
create policy preferences_insert_own
  on public.student_preferences for insert to authenticated
  with check ((select private.owns_enabled_student_index(index_number)));
create policy preferences_update_own
  on public.student_preferences for update to authenticated
  using ((select private.owns_enabled_student_index(index_number)))
  with check ((select private.owns_enabled_student_index(index_number)));

grant all privileges on all tables in schema public to service_role;
grant all privileges on all sequences in schema public to service_role;
grant execute on function public.reserve_student_auth_request(text, text, text)
  to service_role;

commit;

notify pgrst, 'reload schema';

-- Verification: PUBLIC/anon must have zero grants; authenticated must have only the
-- explicitly listed owned-table grants above.
select grantee, table_name, privilege_type
from information_schema.role_table_grants
where table_schema = 'public'
  and grantee in ('PUBLIC', 'anon', 'authenticated')
order by table_name, grantee, privilege_type;

select schemaname, tablename, policyname, roles, cmd
from pg_policies
where schemaname = 'public'
order by tablename, policyname;
